    "Sign in to leave this fight." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous pour quitter ce défi."}}}},
    "Start a new fight, or join one that's already going." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Lancez un nouveau défi, ou rejoignez-en un déjà en cours."}}}},
