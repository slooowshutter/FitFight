  "strings" : {
    "Challenge your friends.\nWinner takes the glory." : {
      "comment" : "Home screen tagline under the FitFight title.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défie tes amis.\nLe gagnant rafle la gloire."
          }
        }
      }
    },
    "Close" : {
      "comment" : "Button that dismisses the Versions or Settings sheet.",
      "localizations" : {
        "fr" : {
