        },
        "Custom": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Personnalisé"
                    }
                }
            }
        },
        "End": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fin"
                    }
                }
            }
        },
        "Scheduled": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Programmé"
                    }
                }
            }
        },
        "Slide to schedule": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Glisser pour programmer"
                    }
                }
            }
        },
        "Choose a start time in the future.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisis une heure de départ dans le futur."
                    }
                }
            }
        },
        "The end must be after the start.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La fin doit être après le départ."
                    }
                }
            }
        },
        "Choose the exact start and end. Only steps inside this window count.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisis le départ et la fin exacts. Seuls les pas dans cette période comptent."
                    }
                }
            }
        },
        "Most Steps inside the selected window wins.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le plus de pas pendant la période choisie gagne."
                    }
                }
            }
        },
        "More settings": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Plus de réglages"
                    }
                }
            }
        },
        "Fewer settings": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Moins de réglages"
                    }
                }
            }
        },
        "Request Health access": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Demander l’accès à Santé"
                    }
                }
            }
        },
        "Ask for access to Health types you haven’t reviewed yet. Fights use Steps only.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Demande l’accès aux données Santé que tu n’as pas encore examinées. Les défis utilisent uniquement les pas."
                    }
                }
            }
        },
        "Review": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vérifier"
                    }
                }
            }
        },
        "Change Health permissions": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifier les autorisations Santé"
                    }
                }
            }
        },
        "In Health, tap your profile → Apps → FitFight to turn each type of access on or off.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dans Santé, touche ton profil → Apps → FitFight pour activer ou désactiver chaque accès."
                    }
                }
            }
        },
        "fight.starts-at": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Starts %@"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Départ %@"
                    }
                }
            }
        },
        "fight.custom-window": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%1$@ → %2$@"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%1$@ → %2$@"
                    }
                }
            }
        },
        "Feed photos keep their original shape and fill the post width. A wide photo stays short, a tall one stays tall. Nothing is cropped to a fixed frame.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les photos du fil gardent leur forme d’origine et prennent toute la largeur du post. Une photo large reste basse, une photo haute reste haute. Plus de recadrage dans un cadre fixe."
                    }
                }
            }
        },
        "Photos and profile pictures now show up much faster. They stay on the phone after the first load, so Feed, Fights and You don’t sit on empty boxes.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les photos et les avatars s’affichent beaucoup plus vite. Ils restent sur le téléphone après le premier chargement, donc le Fil, Défis et Toi ne restent plus bloqués sur des cases vides."
                    }
                }
            }
        },
        "Apple Health Steps still syncs even if extra workout details fail. You shows the real server or network error instead of only Sync failed, and no longer labels a failed sync as Connected.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les pas Apple Health se synchronisent toujours même si les détails d’entraînement en plus échouent. Toi affiche la vraie erreur serveur ou réseau au lieu de seulement Synchronisation échouée, et ne marque plus une sync ratée comme Connecté."
                    }
                }
            }
        },
        "Your selected companion now appears as your avatar across You, fights and Feed. Apple Health details stay behind More settings. Choose Custom when creating a fight to set exact start and end dates and times.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ton compagnon choisi devient ton avatar dans Toi, les défis et le fil. Les détails Santé restent derrière Plus de réglages. Choisis Personnalisé à la création pour définir les dates et heures exactes de départ et de fin."
                    }
                }
            }
        },
        "Loading": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Chargement"
                    }
                }
            }
        },
        "Joining…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rejoindre…"
                    }
                }
            }
        },
        "Join shows a spinner while public fights load. Opening one stays on Join with a Join button, not the live fight and its step refresh.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rejoindre affiche une roue pendant le chargement des défis publics. En ouvrir un reste sur Rejoindre, avec un bouton Rejoindre, pas le défi en cours ni le rafraîchissement des pas."
                    }
                }
            }
        },
        "Try again": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Réessayer"
                    }
                }
            }
        },
        "Retry": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Réessayer"
                    }
                }
            }
        },
        "Today's check-in": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Point du jour"
                    }
                }
            }
        },
        "Refer a friend": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Parrainer un ami"
                    }
                }
            }
        },
        "Share fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Partager le défi"
                    }
                }
            }
        },
        "Couldn’t save referral": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible d’enregistrer le parrainage"
                    }
                }
            }
        },
        "Your referral hasn’t been saved yet. Check your connection and try again.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ton parrainage n’a pas encore été enregistré. Vérifie ta connexion et réessaie."
                    }
                }
            }
        },
        "The Fights list shows how much time is left as months, weeks, days, hours, and minutes, without the end date. Under two days you see the days and the hours. Inside a fight, the exact end time is still there.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La liste des défis affiche maintenant le temps restant en mois, semaines, jours, heures et minutes, sans la date de fin. En dessous de deux jours, vous voyez les jours et les heures. Dans un défi, l’heure exacte de fin est toujours là."
                    }
                }
            }
        },
        "Apple Health can also sync energy, distance, exercise, stand, flights, and workouts. Fights still use steps only. Other activity stays private on your account.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Santé d’Apple peut aussi synchroniser l’énergie, la distance, l’exercice, le temps debout, les étages et les entraînements. Les défis utilisent encore seulement les pas. Les autres activités restent privées sur votre compte."
                    }
                }
            }
        },
        "Bugs & requests now has Report and Hide this person on other people’s posts, the same way Feed does.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs et demandes propose désormais Signaler et Masquer cette personne sur les publications des autres, comme dans Fil."
                    }
                }
            }
        },
        "Bugs & requests now lets you post as soon as the title and details each have at least one character.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs et demandes te laisse maintenant publier dès que le titre et les détails ont chacun au moins un caractère."
                    }
                }
            }
        },
        "Slide to start keeps vibrating until you let go, and the pulses speed up as you drag farther.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Glissez pour lancer vibre sans s’arrêter tant que vous tenez, et les impulsions s’accélèrent à mesure que vous avancez."
                    }
                }
            }
        },
        "Fight standings update as soon as your Steps sync, instead of waiting about 30 seconds.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le classement d’un défi se met à jour dès que tes pas sont synchronisés, au lieu d’attendre environ 30 secondes."
                    }
                }
            }
        },
        "This permanently deletes your profile, photos, uploaded Steps, referrals, invitations, fights you created, and bugs or requests you posted; removes you from other fights; and signs you out. This can’t be undone.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cette action supprime définitivement ton profil, tes photos, les pas envoyés, les parrainages, les invitations, les défis créés et les bugs ou demandes publiés ; elle te retire des autres défis et te déconnecte. Cette action est irréversible."
                    }
                }
            }
        },
        "New fights now repeat when they end. You can still turn that off while creating.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les nouveaux défis se répètent maintenant à la fin. Tu peux encore désactiver ça pendant la création."
                    }
                }
            }
        },
        "Your profile and username now use the FitFight API, keeping the app compatible as the database evolves.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Votre profil et votre nom d’utilisateur passent désormais par l’API FitFight pour que l’app reste compatible avec les évolutions de la base de données."
                    }
                }
            }
        },
        "Buttons now tap with haptic feedback, and Slide to start ticks harder as you drag the thumb toward the end.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les boutons vibrent maintenant au toucher, et Glissez pour lancer accélère les vibrations à mesure que le pouce avance vers la fin."
                    }
                }
            }
        },
        "Refer a friend from You or share a fight directly. Links help friends install FitFight through TestFlight, and reopening the link after installation keeps the referral and challenge together.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Parraine un ami depuis Vous ou partage directement un défi. Les liens aident tes amis à installer FitFight avec TestFlight. Rouvrir le lien après l’installation conserve le parrainage et le défi."
                    }
                }
            }
        },
        "On a repeating fight, after the start day you can join this round or wait for the next one. People waiting for the next round show up on the fight without counting in this round’s standings.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sur un défi répétitif, après le jour de début, vous pouvez rejoindre ce tour ou attendre le suivant. Les personnes qui attendent le prochain tour apparaissent dans le défi sans compter dans le classement de ce tour."
                    }
                }
            }
        },
        "A tap anywhere on a Bugs & requests card opens it, not only the title.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toucher n’importe où sur une carte Bugs et demandes l’ouvre, pas seulement le titre."
                    }
                }
            }
        },
        "Bugs & requests now sits on its own on You, above Settings.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs et demandes a désormais sa propre section dans Vous, au-dessus de Réglages."
                    }
                }
            }
        },
        "The website now uses the centered FitFight logo with a transparent background in browser tabs.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le site utilise désormais le logo FitFight centré sur fond transparent dans les onglets du navigateur."
                    }
                }
            }
        },
        "Feed lists posts from fights you’re in, not Public. Plus posts to those fights. Bugs & requests no longer shows device details.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le fil liste les publications de tes défis, pas Public. Plus publie dans ces défis. Bugs et demandes n’affiche plus les détails de l’appareil."
                    }
                }
            }
        },
        "Send to Cursor includes the phone details from your device. Bugs & requests still hides them on the board.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Envoyer à Cursor inclut les détails du téléphone. Bugs et demandes les masque toujours sur le tableau."
                    }
                }
            }
        },
        "Posts from fights you’re in.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publications des défis auxquels tu participes."
                    }
                }
            }
        },
        "Internal TestFlight build so the update overlay can be checked from 188.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Build TestFlight interne pour vérifier l’overlay de mise à jour depuis la 188."
                    }
                }
            }
        },
        "The update screen is the full overlay again. Internal TestFlight latest no longer asks you to update; Friends stay on the public build.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L’écran de mise à jour est de nouveau le grand overlay. La dernière version TestFlight interne ne demande plus de mettre à jour ; les amis restent sur la version publique."
                    }
                }
            }
        },
        "Opening FitFight shows your last Fights right away. Update checks run in the background; if a new build is ready you’ll get a small popup. Challenge reminders are asked once, not every launch. Offline still shows your last Fights.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight affiche tout de suite tes derniers défis. La recherche de mise à jour se fait en arrière-plan ; s’il y en a une, une petite fenêtre s’affiche. Les rappels de défis ne sont demandés qu’une fois. Hors ligne, tes derniers défis restent visibles."
                    }
                }
            }
        },
        "Fights, the challenge page, and stats now show everyone’s photo when they have one, not just initials.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les défis, la page du défi et les stats montrent maintenant la photo de chacun quand il en a une, plus seulement les initiales."
                    }
                }
            }
        },
        "Update FitFight to continue": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Mettez FitFight à jour pour continuer"
                    }
                }
            }
        },
        "Couldn’t check for updates": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de vérifier les mises à jour"
                    }
                }
            }
        },
        "You can’t use FitFight until you install the latest version.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous ne pouvez pas utiliser FitFight tant que vous n’avez pas installé la dernière version."
                    }
                }
            }
        },
        "An outdated beta only shows an update dialog. You can’t use FitFight until you install the latest version.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une bêta obsolète affiche seulement une boîte de dialogue de mise à jour. Vous ne pouvez pas utiliser FitFight tant que vous n’avez pas installé la dernière version."
                    }
                }
            }
        },
        "Update FitFight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Mettre FitFight à jour"
                    }
                }
            }
        },
        "Check again": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vérifier à nouveau"
                    }
                }
            }
        },
        "A FitFight update is available": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une mise à jour de FitFight est disponible"
                    }
                }
            }
        },
        "Open TestFlight to check for the update. If it isn’t available yet, cancel and keep using FitFight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ouvrez TestFlight pour vérifier la mise à jour. Si elle n’est pas encore disponible, annulez et continuez à utiliser FitFight."
                    }
                }
            }
        },
        "TestFlight updates no longer block the app. Cancel to keep using FitFight, and the same update will stay dismissed.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les mises à jour TestFlight ne bloquent plus l’app. Annulez pour continuer à utiliser FitFight. La même mise à jour ne vous sera plus proposée."
                    }
                }
            }
        },
        "FitFight now requires the latest available app version. An update screen stays until you install it, with a direct link to TestFlight or the App Store.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight exige désormais la dernière version disponible de l’app. Un écran de mise à jour reste affiché jusqu’à son installation, avec un lien direct vers TestFlight ou l’App Store."
                    }
                }
            }
        },
        "Create and Join on New now use the same gray captions, and they no longer mention codes or inviting people.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Créer et Rejoindre dans Nouveau utilisent maintenant les mêmes légendes grises, et ne parlent plus des codes ni des invitations."
                    }
                }
            }
        },
        "Create and Join on New now use the same icon size.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Créer et Rejoindre dans Nouveau utilisent maintenant la même taille d’icône."
                    }
                }
            }
        },
        "Sync error reference": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Référence de l’erreur de synchronisation"
                    }
                }
            }
        },
        "Apple Health sync failures now include an error reference on You and diagnostic details to help investigate.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les échecs de synchronisation avec Santé affichent désormais une référence d’erreur dans You et des détails de diagnostic pour faciliter l’enquête."
                    }
                }
            }
        },
        "Fights refresh with fewer network requests, and private Apple Health timing logs help diagnose slow syncs.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les combats se rafraîchissent avec moins de requêtes réseau, et des journaux de durée privés pour Santé aident à diagnostiquer les synchronisations lentes."
                    }
                }
            }
        },
        "Apple Health on You shows today’s step count correctly.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Santé d’Apple, dans You, affiche correctement le nombre de pas du jour."
                    }
                }
            }
        },
        "Invitation responses are secured, and unavailable Apple Health data no longer replaces saved Steps with zero.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les réponses aux invitations sont sécurisées et les données Santé indisponibles ne remplacent plus les pas enregistrés par zéro."
                    }
                }
            }
        },
        "1 month": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "1 mois"
                    }
                }
            }
        },
        "1 week": {
