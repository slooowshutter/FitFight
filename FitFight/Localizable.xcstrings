        "Delete this post?": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Supprimer cette publication ?"
                    }
                }
            }
        },
        "That fight isn’t on your list.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ce défi n’est pas dans ta liste."
                    }
                }
            }
        },
        "Plus starts with no destination: pick Public or a fight. Public posts and fight posts look different. You can edit or delete your own posts. Tags are people you’ve already finished a fight with.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Plus commence sans destination : choisis Public ou un défi. Les publications publiques et celles d’un défi se distinguent. Tu peux modifier ou supprimer tes publications. Les identifications sont les personnes avec qui tu as déjà terminé un défi."
                    }
                }
            }
        },
        "Comment": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Commenter"
                    }
                }
            }
        },
