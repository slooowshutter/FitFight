        "A streak is consecutive recorded days in the same level. Unknown days interrupt the record.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A streak is consecutive recorded days in the same level. Unknown days interrupt the record."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une série compte les journées enregistrées consécutives au même niveau. Les journées inconnues interrompent le suivi."
                    }
                }
            }
        },
        "Current streak unavailable until yesterday is complete.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Current streak unavailable until yesterday is complete."
                    }
                },
                "fr": {
                    "stringUnit": {
