            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les tiens"
                    }
                }
            }
        },
        "Loading saved descriptions": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Chargement des descriptions enregistrées"
                    }
                }
            }
        },
        "Your saved descriptions will appear here.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tes descriptions enregistrées apparaîtront ici."
                    }
                }
            }
        },
        "Use this saved description": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Utiliser cette description enregistrée"
                    }
                }
            }
        },
        "Couldn’t load your saved descriptions.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de charger tes descriptions enregistrées."
                    }
                }
            }
        },
        "Companion descriptions stay saved when you change animals. Browse habitats and reuse your saved descriptions from Yours.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les descriptions de compagnons restent enregistrées quand tu changes d’animal. Explore les habitats et réutilise tes descriptions dans Les tiens."
                    }
                }
            }
        },
        "Reuse a saved description or write a new one in Make it yours.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Réutilise une description enregistrée ou écris-en une nouvelle dans À ton image."
                    }
                }
            }
        },
        "Search time zones": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Search time zones"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rechercher un fuseau horaire"
                    }
                }
            }
        },
        "Time zone": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Time zone"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fuseau horaire"
                    }
                }
            }
        },
        "Your daily Steps and new Fights use this time zone, even when you travel.": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Your daily Steps and new Fights use this time zone, even when you travel."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vos pas quotidiens et vos nouveaux défis utilisent ce fuseau horaire, même en voyage."
                    }
                }
            }
        },
        "Your time zone stays fixed when you travel and can be changed in Edit profile. Custom Fights let you choose their time zone. Profile statistics refresh after Health sync, and Feedback comment counts open the discussion.": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Your time zone stays fixed when you travel and can be changed in Edit profile. Custom Fights let you choose their time zone. Profile statistics refresh after Health sync, and Feedback comment counts open the discussion."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Votre fuseau horaire reste fixe en voyage et peut être modifié dans Modifier le profil. Les défis personnalisés permettent de choisir leur fuseau horaire. Les statistiques du profil sont actualisées après la synchronisation Santé et le nombre de commentaires ouvre la discussion dans Feedback."
                    }
                }
            }
        },
        "feedback.comment-count": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%lld comments"
