            "state" : "translated",
            "value" : "Fermer"
          }
        }
      }
    },
    "English and French. Follows your iPhone language. Change FitFight only in iOS Settings." : {
      "comment" : "Changelog notes for the localization release.",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anglais et français. Suit la langue de ton iPhone. Change FitFight seulement dans Réglages iOS."
          }
        }
      }
    },
    "First TestFlight. App name on screen, version at the top, and a Versions list for every release." : {
      "comment" : "Changelog notes for the first TestFlight release.",
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier TestFlight. Nom de l'app à l'écran, version en haut, et une liste Versions pour chaque publication."
          }
        }
      }
    },
    "FitFight" : {
      "comment" : "App name on the home screen. Keep as FitFight in every language.",
      "shouldTranslate" : false
    },
    "FitFight follows your iPhone language. Tap Language to pick English or French for this app only." : {
      "comment" : "Explanation under the Language heading in Settings.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FitFight suit la langue de ton iPhone. Touche Langue pour choisir l'anglais ou le français pour cette app seulement."
          }
        }
      }
    },
    "Language" : {
      "comment" : "Settings heading and row that opens iOS Settings for per-app language.",
