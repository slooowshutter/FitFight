        "This also shares step records, averages, activity levels and streaks for that period. Your full recorded history stays private.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "This also shares step records, averages, activity levels and streaks for that period. Your full recorded history stays private."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les records de pas, moyennes, niveaux d’activité et séries de cette période sont aussi partagés. Votre historique complet reste privé."
                    }
                }
            }
        },
        "Profiles now show your best recorded step day, weekly averages, activity-level distribution and streaks. Shared statistics respect your chosen audience and history period.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Profiles now show your best recorded step day, weekly averages, activity-level distribution and streaks. Shared statistics respect your chosen audience and history period."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les profils affichent votre meilleure journée de pas enregistrée, les moyennes hebdomadaires, la répartition des niveaux d’activité et les séries. Les statistiques partagées respectent le public et la période choisis."
                    }
                }
            }
        },
        "Profile history keeps private Fight participants hidden and opens the selected round. Scheduled Fight records and rematch durations are now preserved.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Profile history keeps private Fight participants hidden and opens the selected round. Scheduled Fight records and rematch durations are now preserved."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L'historique des profils garde les participants des Fights privés confidentiels et ouvre la manche sélectionnée. Les résultats des Fights programmés et la durée des revanches sont désormais préservés."
                    }
                }
            }
        },
        "Last updated": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Last updated"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dernière mise à jour"
                    }
                }
            }
        },
        "Profiles now include Friends, private sharing controls, Fight records and head-to-head rivalries. Tap a person to open their profile or challenge them. Suggested public Fights are optional at the end of onboarding.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Profiles now include Friends, private sharing controls, Fight records and head-to-head rivalries. Tap a person to open their profile or challenge them. Suggested public Fights are optional at the end of onboarding."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les profils incluent les amis, les réglages de partage, les résultats des Fights et les rivalités en duel. Touchez une personne pour ouvrir son profil ou la défier. Les Fights publics suggérés sont facultatifs à la fin de la présentation."
                    }
                }
            }
        },
        "Joined": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Inscrit"
                    }
                }
            }
        },
        "Skip": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Passer"
                    }
                }
            }
        },
        "Suggested Fights": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Suggested Fights"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fights suggérés"
                    }
                }
            }
        },
        "Join a public Fight if you like. Nothing is joined automatically, and your profile settings stay yours.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Join a public Fight if you like. Nothing is joined automatically, and your profile settings stay yours."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rejoignez un Fight public si vous le souhaitez. Aucune inscription automatique, et vos réglages de profil restent inchangés."
                    }
                }
            }
        },
        "Steps. Highest total wins.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Steps. Highest total wins."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pas. Le total le plus élevé gagne."
                    }
                }
            }
        },
        "Repeats until you leave. Each round has its own result.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Repeats until you leave. Each round has its own result."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Se répète jusqu’à votre départ. Chaque manche a son propre résultat."
                    }
                }
            }
        },
        "Participants see your identity, Fight Steps, standings, and posts you share in this Fight. Joining does not enable profile or daily-history sharing.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Participants see your identity, Fight Steps, standings, and posts you share in this Fight. Joining does not enable profile or daily-history sharing."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les participants voient votre identité, vos pas et votre classement dans ce Fight, ainsi que les publications que vous y partagez. Rejoindre le Fight n’active pas le partage du profil ou de l’historique quotidien."
                    }
                }
            }
        },
        "suggested.participants": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%d participants"
                    }
                },
                "fr": {
