        "steps today": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "pas aujourd’hui"
                    }
                }
            }
        },
        "Meet your walking companion. Fights shows today’s Apple Health steps, fight details use a clearer score layout, and New and You share the Companion look. Try the stock animals in You; this design-preview choice lasts for the current session.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Découvre ton compagnon de marche. Défis affiche les pas du jour de Santé d’Apple, les scores sont plus lisibles dans les défis, et Nouveau et Toi adoptent le style Companion. Essaie les animaux dans Toi ; ce choix de design dure le temps de la session."
                    }
                }
            }
        },
        "companion.day": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Day %lld"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Jour %lld"
                    }
                }
            }
        },
        "companion.fight-total": {
            "extractionState": "manual",
