                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Détails"
                    }
                }
            }
        },
        "Feature": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fonctionnalité"
                    }
                }
            }
        },
        "Features": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fonctions"
                    }
                }
            }
        },
        "New request": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nouvelle demande"
                    }
                }
            }
        },
        "No comments yet.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pas encore de commentaires."
                    }
                }
            }
        },
        "No requests yet": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Aucune demande pour l’instant"
                    }
                }
            }
        },
        "Post": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publier"
                    }
                }
            }
        },
        "Post a bug or a feature request. Other people can upvote and comment with their username.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Signalez un bug ou proposez une fonctionnalité. Les autres peuvent voter et commenter avec leur nom d’utilisateur."
                    }
                }
            }
        },
        "Posted with your username. Signed-in people can see it, upvote, and comment.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publié avec votre nom d’utilisateur. Les personnes connectées peuvent le voir, voter et commenter."
                    }
                }
            }
        },
        "Posting…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publication…"
                    }
                }
            }
        },
        "Request": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Demande"
                    }
                }
            }
        },
        "Short and specific": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Court et précis"
                    }
                }
            }
        },
        "That isn’t available anymore.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ce n’est plus disponible."
                    }
                }
            }
        },
        "Title": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Titre"
                    }
                }
            }
        },
        "Title and action": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Titre et gage"
                    }
                }
            }
        },
        "Both are optional. If you skip a title, the action is the name of the fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les deux sont facultatifs. Sans titre, le gage devient le nom du défi."
                    }
                }
            }
        },
        "Weekend walk-off": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Défi du week-end"
                    }
                }
            }
        },
        "None": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Aucun"
                    }
                }
            }
        },
        "Uses the action": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Utilise le gage"
                    }
                }
            }
        },
        "Keep the title to 120 characters.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Limitez le titre à 120 caractères."
                    }
                }
            }
        },
        "You can name a fight. Title and action are both optional; if you skip a title, the action is the name on Fights.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous pouvez nommer un défi. Le titre et le gage sont tous les deux facultatifs ; sans titre, le gage devient le nom dans Défis."
                    }
                }
            }
        },
        "Top": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Top"
                    }
                }
            }
        },
        "Upvote": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Voter"
                    }
                }
            }
        },
        "What happened, or what you want. Be specific.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ce qui s’est passé, ou ce que vous voulez. Soyez précis."
                    }
                }
            }
        },
        "You’ve posted a few times recently. Try again later.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous avez déjà beaucoup publié récemment. Réessayez plus tard."
                    }
                }
            }
        },
        "You → Settings now has Bugs & requests: post a bug or a feature request, see what other people submitted, upvote, and comment with your username.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous → Réglages propose désormais Bugs et demandes : signalez un bug ou une fonctionnalité, voyez les demandes des autres, votez et commentez avec votre nom d’utilisateur."
                    }
                }
            }
        },
