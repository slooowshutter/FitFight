        "Beta account": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Compte bêta"
                    }
                }
            }
        },
        "Couldn’t load your preferences. Try again.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de charger tes préférences. Réessaie."
                    }
                }
            }
        },
        "Choose your language and appearance in You → Preferences. Your choices are saved to your account. Find notification settings, beta access, and your installed app details in the same place.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisis ta langue et ton apparence dans Toi → Préférences. Tes choix sont enregistrés sur ton compte. Retrouve au même endroit les notifications, l’accès à la bêta et les détails de ton application."
                    }
                }
            }
        },
        "The comment Send button turns green as soon as you type. Empty or spaces-only comments keep it gray and disabled.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le bouton Envoyer des commentaires devient vert dès que tu écris. Si le commentaire est vide ou ne contient que des espaces, il reste gris et désactivé."
                    }
                }
            }
        },
        "Account environment": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Environnement du compte"
                    }
                }
            }
        },
        "Fight notifications open the exact round they refer to, even when the next round has already started.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les notifications de combat ouvrent la manche concernée, même si la suivante a déjà commencé."
                    }
                }
            }
        },
