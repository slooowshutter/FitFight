            }
        },
        "Tentative lead": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "En tête provisoire"
                    }
                }
            }
        },
        "Tentative loss": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Retard provisoire"
                    }
                }
            }
        },
        "Repeating fights stay on one page. A History tab lists earlier windows with their standings and result. The Fights list shows one row per series. Standings put the leader in a winner band, then everyone else below.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les défis qui se répètent restent sur une seule page. Un onglet Historique liste les fenêtres précédentes avec leur classement et leur résultat. La liste Défis affiche une ligne par série. Le classement met le leader dans un bandeau gagnant, puis tous les autres en dessous."
                    }
                }
            }
        },
        "After a fight ends, Finished shows P until everyone syncs or 24 hours pass. Miss the window and you lose. Opening it shows a tentative result, not a win.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Après la fin d’un défi, Terminés affiche P tant que tout le monde n’a pas synchronisé ou que 24 heures ne sont pas passées. Raté la fenêtre et tu perds. L’ouvrir montre un résultat provisoire, pas une victoire."
                    }
                }
            }
        },
        "Allow notifications": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Autoriser les notifications"
                    }
                }
            }
        },
        "FitFight can remind you when a fight ends and when to sync before the 24-hour window closes. Allow notifications only when the server can send them.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight peut vous rappeler quand un défi se termine et quand synchroniser avant la fin de la fenêtre de 24 heures. Autorisez les notifications seulement quand le serveur peut les envoyer."
                    }
                }
            }
        },
        "FitFight can remind you when a fight ends and when to sync your steps. Lock-screen alerts never show scores or fight titles.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight peut vous rappeler quand un défi se termine et quand synchroniser vos pas. Les alertes sur l’écran verrouillé n’affichent jamais de scores ni de titres de défi."
                    }
                }
            }
        },
        "Get fight-end reminders?": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Recevoir des rappels de fin de défi ?"
                    }
                }
            }
        },
        "Did not sync · forfeited": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pas synchronisé · forfait"
                    }
                }
            }
        },
        "fight.finished-tied": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ · Tied"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ · Égalité"
                    }
                }
            }
        },
        "fight.sync-time-left": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ left to sync"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "%@ pour synchroniser"
                    }
                }
            }
        },
        "Challenge reminders": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rappels de défis"
                    }
                }
            }
        },
        "FitFight will send challenge reminders. Lock-screen alerts never include step counts.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight enverra des rappels de défis. Les alertes sur l’écran verrouillé n’incluent jamais le nombre de pas."
                    }
                }
            }
        },
        "Debug": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Débogage"
                    }
                }
            }
        },
        "Design system": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Système de design"
                    }
                }
            }
        },
        "Internal kit. Not shown to other people.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Kit interne. Les autres ne le voient pas."
                    }
                }
            }
        },
        "Developer": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Développeur"
                    }
                }
            }
        },
        "Replay onboarding": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Relancer l’accueil"
                    }
                }
            }
        },
        "Health, challenge reminders, and Bugs & requests. Your account and fights stay.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Santé d’Apple, rappels de défis, et Bugs et demandes. Ton compte et tes défis restent."
                    }
                }
            }
        },
        "OK": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "OK"
                    }
                }
            }
        },
        "Device": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Appareil"
                    }
                }
            }
        },
        "Bugs & requests posts and comments now include the app version, phone, and settings so we can debug faster.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les bugs et demandes enregistrent maintenant la version de l’app, le téléphone et les réglages, pour qu’on puisse déboguer plus vite."
                    }
                }
            }
        },
        "Setup now ends with a last screen: go to Settings to submit a feature you want or a bug you see. Those will be fixed rapidly.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L’installation se termine maintenant par un dernier écran : va dans Réglages pour proposer une fonctionnalité que tu veux ou un bug que tu vois. On les corrige rapidement."
                    }
                }
            }
        },
        "New accounts are asked about challenge reminders during setup, before iPhone’s permission sheet. Lock-screen alerts never include step counts. Versions stays under You → Settings.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les nouveaux comptes sont interrogés sur les rappels de défis pendant l’installation, avant la feuille d’autorisation de l’iPhone. Les alertes sur l’écran verrouillé n’incluent jamais le nombre de pas. Versions reste dans Vous → Réglages."
                    }
                }
            }
        },
        "Crashes are now reported so we can fix them. Reports do not include Apple Health or Steps.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les plantages sont désormais envoyés pour qu’on puisse les corriger. Les rapports n’incluent pas Santé d’Apple ni les pas."
                    }
                }
            }
        },
        "Invited on Fights now shows how many invitations are waiting. The number hides when there are none.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Invités dans Défis affiche maintenant le nombre d’invitations en attente. Le chiffre disparaît quand il n’y en a plus."
                    }
                }
            }
        },
        "Edit fight now keeps the version and header tight at the top, and the recap names your opponents instead of showing join instructions.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifier le défi garde maintenant la version et l’en-tête serrés en haut, et le récapitulatif nomme tes adversaires au lieu d’afficher les instructions pour rejoindre."
                    }
                }
            }
        },
        "FitFight has a new green and beige double-F app icon.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight a une nouvelle icône : un double F beige sur fond vert."
                    }
                }
            }
        },
        "Take Photo and Photo Library now open after you tap Media.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Prendre une photo et Photothèque s’ouvrent maintenant après Médias."
                    }
                }
            }
        },
        "A fight you just created stays on your list even if the refresh failed.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Un défi que tu viens de créer reste dans ta liste même si la mise à jour a échoué."
                    }
                }
            }
        },
        "Tapping an animal keeps that character on screen with its own poses. Other animals no longer show the hiking goat pictures.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toucher un animal garde ce personnage à l’écran avec ses propres poses. Les autres animaux n’affichent plus les images de la chèvre en rando."
                    }
                }
            }
        },
        "Choose a companion from a grid of animals, or Custom. Custom is one description: species, breed, accessories, colors.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisis un compagnon dans une grille d’animaux, ou Personnalisé. Personnalisé, c’est une seule description : espèce, race, accessoires, couleurs."
                    }
                }
            }
        },
        "Your animal": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ton animal"
                    }
                }
            }
        },
        "Write the species, breed or race, accessories, colors, and anything else that should appear.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Écris l’espèce, la race, les accessoires, les couleurs, et tout ce qui doit apparaître."
                    }
                }
            }
        },
        "Species, breed, accessories, colors…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Espèce, race, accessoires, couleurs…"
                    }
                }
            }
        },
        "Save companion": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Enregistrer le compagnon"
                    }
                }
            }
        },
        "Your own animal.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ton propre animal."
                    }
                }
            }
        },
        "You can take a photo with the camera when you add Media, not only pick one from the library.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux prendre une photo avec l’appareil photo quand tu ajoutes des Médias, pas seulement en choisir une dans la photothèque."
                    }
                }
            }
        },
        "Couldn’t save your companion. Try again.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible d’enregistrer ton compagnon. Réessaie."
                    }
                }
            }
        },
        "Two-word companion names now capitalize both words, like Red Panda.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les noms de compagnon en deux mots mettent désormais une majuscule à chaque mot, comme Panda Roux."
                    }
                }
            }
        },
        "You can post from a fight’s Feed, not only from the main Feed tab.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux publier depuis le Fil d’un défi, pas seulement depuis l’onglet Fil."
                    }
                }
            }
        },
        "You can still use FitFight when you’re offline. The update screen only appears when an update is actually required, not when the version check can’t reach the internet.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux encore utiliser FitFight hors ligne. L’écran de mise à jour n’apparaît que lorsqu’une mise à jour est vraiment obligatoire, pas quand la vérification n’arrive pas à joindre Internet."
                    }
                }
            }
        },
        "If you created a fight, Edit lets you change private or public, the title, the loser action, the duration, whether it repeats, who is in it, and kick people out.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Si tu as créé un défi, Modifier te permet de changer privé ou public, le titre, le gage, la durée, s’il se répète, qui y participe, et d’en retirer des personnes."
                    }
                }
            }
        },
        "Bugs & requests can include a photo, a video, or any file.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs et demandes peuvent inclure une photo, une vidéo ou n’importe quel fichier."
                    }
                }
            }
        },
        "Add": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ajouter"
                    }
                }
            }
        },
        "Couldn’t save the fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible d’enregistrer le défi."
                    }
                }
            }
        },
        "Created this fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "A créé ce défi"
                    }
                }
            }
        },
        "Edit fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifier le défi"
                    }
                }
            }
        },
        "In this fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Dans ce défi"
                    }
                }
            }
        },
        "Owner": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Créateur"
                    }
                }
            }
        },
        "People": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Personnes"
                    }
                }
            }
        },
        "Save changes": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Enregistrer"
                    }
                }
            }
        },
        "Sign in to edit this fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecte-toi pour modifier ce défi."
                    }
                }
            }
        },
        "The end must be in the future.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La fin doit être dans le futur."
                    }
                }
            }
        },
        "Will be invited": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sera invité"
                    }
                }
            }
        },
        "Slide to start now ticks like a switch as you drag, instead of buzzing the whole time.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Glisser pour commencer fait maintenant des clics comme un interrupteur quand tu glisses, au lieu de vibrer tout le temps."
                    }
                }
            }
        },
        "Tap to retry": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Touche pour réessayer"
                    }
                }
            }
        },
        "Syncing": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Synchro"
                    }
                }
            }
        },
        "A failed Apple Health sync now shows why, in ember, with a Retry pill instead of Connected.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une synchro Santé d’Apple ratée affiche maintenant pourquoi, en braise, avec un bouton Réessayer au lieu de Connecté."
                    }
                }
            }
        },
        "health.sync-server-failed": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "FitFight's server could not save your Steps (error %lld)."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le serveur FitFight n’a pas pu enregistrer tes pas (erreur %lld)."
                    }
                }
            }
        },
        "Choosing a companion now shows five effort poses. Weekly movement changes the pose; you can set sport, breed, and mood.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Choisir un compagnon montre maintenant cinq poses d’effort. Ton mouvement dans la semaine change la pose ; tu peux régler le sport, la race et l’humeur."
                    }
                }
            }
        },
        "Posting to several fights now shows once on Feed, with those fight names or Public.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publier dans plusieurs défis n’apparaît plus qu’une fois dans le Fil, avec ces noms de défis ou Public."
                    }
                }
            }
        },
        "New can start a fight, join one, or post. Suggested fights sit under those choices.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Nouveau peut lancer un défi, en rejoindre un, ou publier. Les défis suggérés sont sous ces choix."
                    }
                }
            }
        },
        "Species": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Espèce"
                    }
                }
            }
        },
        "Sport": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sport"
                    }
                }
            }
        },
        "Running": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Course"
                    }
                }
            }
        },
        "Ski": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ski"
                    }
                }
            }
        },
        "Walking": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Marche"
                    }
                }
            }
        },
        "Determined": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Déterminé"
                    }
                }
            }
        },
        "Climbing": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "En montée"
                    }
                }
            }
        },
        "Couldn’t update that suggestion.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de mettre à jour cette suggestion."
                    }
                }
            }
        },
        "Share a note, photo, or video on the Feed": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Partage une note, une photo ou une vidéo dans le Fil"
                    }
                }
            }
        },
        "Sign in to suggest this fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecte-toi pour suggérer ce défi."
                    }
                }
            }
        },
        "Suggest": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Suggérer"
                    }
                }
            }
        },
        "Suggested": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Suggéré"
                    }
                }
            }
        },
        "No suggested fights right now.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Aucun défi suggéré pour le moment."
                    }
                }
            }
        },
        "Editing a fight now opens the same summary as creating one. Change jumps to that part, then back. If you created it, Delete at the bottom ends the fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifier un défi ouvre le même récapitulatif qu’à la création. Modifier va à cette étape, puis revient. Si tu l’as créé, Supprimer en bas met fin au défi."
                    }
                }
            }
        },
        "This fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ce défi"
                    }
                }
            }
        },
        "Change a row, then save.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifie une ligne, puis enregistre."
                    }
                }
            }
        },
        "Delete fight?": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Supprimer le défi ?"
                    }
                }
            }
        },
        "This ends the fight for everyone in it. If it repeats, the next windows stop too. This can’t be undone.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cela met fin au défi pour tout le monde. S’il se répète, les prochaines fenêtres s’arrêtent aussi. C’est définitif."
                    }
                }
            }
        },
        "Deleting…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Suppression…"
                    }
                }
            }
        },
        "Sign in to delete this fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecte-toi pour supprimer ce défi."
                    }
                }
            }
        },
        "Couldn’t delete the fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de supprimer le défi."
                    }
                }
            }
        },
        "Done": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Terminé"
                    }
                }
            }
        },
        "Steps after the exact end time do not count.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les pas après l’heure de fin exacte ne comptent pas."
                    }
                }
            }
        },
        "Try upcoming features in TestFlight. Beta builds may have bugs.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Essaie les prochaines fonctionnalités dans TestFlight. Les versions bêta peuvent contenir des bugs."
                    }
                }
            }
        },
        "Installing the beta replaces the App Store app on this device. To switch back, reinstall FitFight from the App Store.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Installer la bêta remplace l’app App Store sur cet appareil. Pour revenir à la version publique, réinstalle FitFight depuis l’App Store."
                    }
                }
            }
        },
        "Open TestFlight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ouvrir TestFlight"
                    }
                }
            }
        },
        "Return to the App Store": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Revenir à l’App Store"
                    }
                }
            }
        },
        "You can open the TestFlight beta or return to the App Store from You → Settings. Before switching, see how installing the beta replaces the app and keeps accounts, fights, and progress in a separate database.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux ouvrir la bêta TestFlight ou revenir à l’App Store depuis Toi → Réglages. Avant de changer de version, découvre comment la bêta remplace l’app et conserve les comptes, les fights et la progression dans une base de données séparée."
                    }
                }
            }
        },
        "The slide haptics lab has a Custom option for tuning rumble, pulses, ramp shapes, the finishing hit, and confirmation distance. Your settings save automatically on this phone.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le laboratoire haptique propose une option Custom pour régler les vibrations continues, les impulsions, leur progression, l’impact final et la distance de confirmation. Vos réglages sont enregistrés automatiquement sur ce téléphone."
                    }
                }
            }
        },
        "Slide to start builds from soft feedback to full-strength vibration, with a heavy finish even on a quick swipe. The 20 haptic tests now have wider ramps and a 0-100 scale.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Glisser pour démarrer passe de vibrations douces à la puissance maximale, avec un impact final puissant même lors d’un geste rapide. Les 20 tests haptiques proposent des montées plus marquées et une échelle de 0 à 100."
                    }
                }
            }
        },
        "Type @ to tag someone in a post or comment. They get a FitFight notification with your name.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tape @ pour mentionner quelqu’un dans une publication ou un commentaire. FitFight lui envoie une notification avec ton nom."
                    }
                }
            }
        },
        "A refreshed App Store description explaining how to start a private step challenge and follow the standings.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une description App Store actualisée pour découvrir comment lancer un défi de pas privé et suivre le classement."
                    }
                }
            }
        },
        "Make it yours": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "À ton image"
                    }
                }
            }
        },
        "Change animal": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Changer d’animal"
                    }
                }
            }
        },
        "This is how other people see you in fights and Feed. You can change your animal anytime.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "C’est ainsi que les autres te voient dans les combats et le fil. Tu peux changer d’animal à tout moment."
                    }
                }
            }
        },
        "You can change your animal anytime. Choose another from the grid or describe any animal below.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux changer d’animal à tout moment. Choisis-en un autre dans la grille ou décris l’animal de ton choix ci-dessous."
                    }
                }
            }
        },
        "Make it yours opens your animal description, ready to edit and save. Use Change animal to choose another companion anytime.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "À ton image ouvre la description de ton animal pour la modifier et l’enregistrer. Utilise Changer d’animal pour choisir un autre compagnon à tout moment."
                    }
                }
            }
        },
        "Feedback keeps loading correctly when you leave a request while it is being deleted.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les demandes continuent de se charger correctement lorsque vous quittez une demande en cours de suppression."
                    }
                }
            }
        },
        "Delete request": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Supprimer la demande"
                    }
                }
            }
        },
        "Delete request?": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Supprimer la demande ?"
                    }
                }
            }
        },
        "This removes the request, comments, and votes for everyone. This cannot be undone.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La demande, les commentaires et les votes seront supprimés pour tout le monde. Cette action est irréversible."
                    }
                }
            }
        },
        "Admins can delete a feedback request from its menu after confirming.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les administrateurs peuvent supprimer une demande depuis son menu après confirmation."
                    }
                }
            }
        },
        "Comment refreshes are more reliable after connection errors. Live updates no longer interrupt loading more comments.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Comment refreshes are more reliable after connection errors. Live updates no longer interrupt loading more comments."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L’actualisation des commentaires est plus fiable après une erreur de connexion. Les mises à jour en direct n’interrompent plus le chargement de commentaires supplémentaires."
                    }
                }
            }
        },
        "Reactions swipe horizontally, with a visible like button and any emoji. Charts refresh without losing your selection and keep missing history clear. Comments load reliably, and notification failures no longer interrupt saved fights.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les réactions défilent horizontalement, avec un bouton J’aime visible et le choix de tout emoji. Les graphiques s’actualisent sans perdre ta sélection et signalent les données manquantes. Les commentaires se chargent correctement et les échecs de notification n’interrompent plus les fights enregistrés."
                    }
                }
            }
        },
        "React": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Réagir"
                    }
                }
            }
        },
        "Other emoji…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Autre emoji…"
                    }
                }
            }
        },
        "Feedback no longer shows a duplicate button above the bottom tabs. Use the plus at the top to add a request.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Le bouton en double au-dessus des onglets a été supprimé de Feedback. Utilisez le plus en haut pour ajouter une demande."
                    }
                }
            }
        },
        "Live feed updates keep loaded comments in place and refresh posts reliably while scrolling. Broadcast posts now update live too.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Live feed updates keep loaded comments in place and refresh posts reliably while scrolling. Broadcast posts now update live too."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les actualisations en direct conservent les commentaires déjà chargés et mettent les publications à jour pendant le défilement. Les publications destinées à tous s’actualisent aussi en direct."
                    }
                }
            }
        },
        "Website download and invitation links open the App Store. The staging website keeps TestFlight access for beta testers.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les liens de téléchargement et d’invitation du site ouvrent l’App Store. Le site de préproduction conserve l’accès à TestFlight pour les bêta-testeurs."
                    }
                }
            }
        },
        "Activity": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Activity"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Activité"
                    }
                }
            }
        },
        "Notifications & activity": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Notifications & activity"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Notifications et activité"
                    }
                }
            }
        },
        "Posts, comments, reactions and membership history from your fights.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Posts, comments, reactions and membership history from your fights."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Publications, commentaires, réactions et historique des participants de vos combats."
                    }
                }
            }
        },
        "No activity yet.": {
            "localizations": {
