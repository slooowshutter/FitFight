    "fight.handle-already-added" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"@%@ is already in this fight."}},"fr":{"stringUnit":{"state":"translated","value":"@%@ participe déjà à ce défi."}}}},
    "fight.hours-left" : {"extractionState":"manual","localizations":{"en":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld hour left"}},"other":{"stringUnit":{"state":"translated","value":"%lld hours left"}}}}},"fr":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld heure restante"}},"other":{"stringUnit":{"state":"translated","value":"%lld heures restantes"}}}}}}},
