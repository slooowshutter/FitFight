    "Finalized without synced steps" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Finalisé sans pas synchronisés"}}}},
    "HealthKit background delivery" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Mises à jour HealthKit en arrière-plan"}}}},
    "Just now" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"À l’instant"}}}},
    "Last automatic sync" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Dernière synchronisation automatique"}}}},
    "Last manual or foreground sync" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Dernière synchronisation manuelle ou au premier plan"}}}},
    "Not yet" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Pas encore"}}}},
    "Open FitFight and try the Apple Health sync again." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Ouvrez FitFight et relancez la synchronisation Santé d’Apple."}}}},
    "Open FitFight to finish syncing." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Ouvrez FitFight pour terminer la synchronisation."}}}},
    "Open FitFight to sync your Steps." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Ouvrez FitFight pour synchroniser vos pas."}}}},
    "Open Settings" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Ouvrir Réglages"}}}},
    "Restricted by this device" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Limitée par cet appareil"}}}},
    "Sign in, then open FitFight to sync." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Connectez-vous, puis ouvrez FitFight pour synchroniser."}}}},
    "Unavailable" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Indisponible"}}}},
    "Unlock your iPhone, then open FitFight." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Déverrouillez votre iPhone, puis ouvrez FitFight."}}}},
    "Waiting for first sync" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"En attente de la première synchronisation"}}}},

    "api.request-failed" : {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Request failed (%lld)."}},"fr":{"stringUnit":{"state":"translated","value":"Échec de la requête (%lld)."}}}},
