        "Add a comment": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ajouter un commentaire"
                    }
                }
            }
        },
        "Send to Cursor": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Envoyer à Cursor"
                    }
                }
            }
        },
        "Send to Cursor now shows a real error if the agent can’t start, instead of a blank 502.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Send to Cursor affiche maintenant une vraie erreur si l’agent ne démarre pas, au lieu d’un 502 vide."
                    }
                }
            }
        },
        "You can file Bugs & requests again. Creating one no longer fails with an internal error.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous pouvez à nouveau publier dans Bugs et demandes. En créer un n’échoue plus avec une erreur interne."
                    }
                }
            }
        },
        "Sending…": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Envoi…"
                    }
                }
            }
        },
        "Open": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ouvrir"
                    }
                }
            }
        },
        "Cursor is on it. A pull request will show up when it’s done.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cursor s’en occupe. Une pull request apparaîtra quand ce sera prêt."
                    }
                }
            }
        },
        "This is only available to the FitFight admin.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ceci est réservé à l’admin FitFight."
                    }
                }
            }
        },
        "Cursor isn’t configured yet.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Cursor n’est pas encore configuré."
                    }
                }
            }
        },
        "On a Bugs & requests post, Marc can tap Send to Cursor to start a cloud agent with the post and comments.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Sur une demande dans Bugs et demandes, Marc peut toucher Envoyer à Cursor pour lancer un agent cloud avec le post et les commentaires."
                    }
                }
            }
        },
        "Bug": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bug"
                    }
                }
            }
        },
        "Bugs": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs"
                    }
                }
            }
        },
        "Bugs & requests": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Bugs et demandes"
                    }
                }
            }
        },
        "Check the title and details, then try again.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vérifiez le titre et les détails, puis réessayez."
                    }
                }
            }
        },
        "Comments": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Commentaires"
                    }
                }
            }
        },
        "Describe it": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Décrivez-le"
                    }
                }
            }
        },
        "Details": {
