                    }
                }
            }
        },
        "Reply to @%@…": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Reply to @%1$@…"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Répondre à @%1$@…"
                    }
                }
            }
        },
        "Feed comments are more compact, with hearts to like replies, a simpler composer, and quick emoji reactions without sorting tabs.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Feed comments are more compact, with hearts to like replies, a simpler composer, and quick emoji reactions without sorting tabs."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les commentaires du fil sont plus compacts, avec un cœur pour aimer les réponses, une saisie simplifiée et des réactions emoji rapides, sans onglets de tri."
                    }
                }
            }
        },
        "Comments are easier to scan with bold names, lighter text, and tighter spacing. Reactions start on the left, ranked by votes, and the reply bar stays aligned.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Comments are easier to scan with bold names, lighter text, and tighter spacing. Reactions start on the left, ranked by votes, and the reply bar stays aligned."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les commentaires sont plus lisibles grâce aux noms en gras, au texte plus léger et aux espacements réduits. Les réactions commencent à gauche, classées par nombre de votes, et la barre de réponse reste alignée."
                    }
                }
            }
        },
        "See you on Sunday! Let's take the longer route by the river.": {
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "See you on Sunday! Let's take the longer route by the river."
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "À dimanche ! Prenons le chemin le plus long au bord de la rivière."
                    }
                }
            }
        },
        "Created by": {
            "extractionState": "manual",
            "localizations": {
                "en": {
                    "stringUnit": {
                        "state": "translated",
