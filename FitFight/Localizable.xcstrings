    "Join one that's already going" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Rejoindre un défi déjà en cours"}}}},
    "Code, invite link, or a public fight" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Code, lien d’invitation, ou un défi public"}}}},
    "Private fights join with a code or invite link. Public fights also show below." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Les défis privés se rejoignent avec un code ou un lien d’invitation. Les défis publics apparaissent aussi ci-dessous."}}}},
    "No live public fights right now. Use a code or invite link." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Aucun défi public pour le moment. Utilisez un code ou un lien d’invitation."}}}},
    "Listed on Join. Anyone with the code or invite link can join. Usernames are optional." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Listé dans Rejoindre. Toute personne avec le code ou le lien d’invitation peut rejoindre. Les noms d’utilisateur sont facultatifs."}}}},
    "New fights start private. People still join with the code or invite link. Usernames are optional." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Les nouveaux défis commencent privés. On peut quand même rejoindre avec le code ou le lien d’invitation. Les noms d’utilisateur sont facultatifs."}}}},
    "Default · code or invite link" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Par défaut · code ou lien d’invitation"}}}},
    "Join with code or invite link" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Rejoindre avec le code ou le lien d’invitation"}}}},
    "Anyone with the code or invite link can join." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Toute personne avec le code ou le lien d’invitation peut rejoindre."}}}},
    "New fights start private. People can still join with the code or invite link; only public fights show on Join." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Les nouveaux défis commencent privés. On peut toujours les rejoindre avec le code ou le lien d’invitation ; seuls les défis publics apparaissent dans Rejoindre."}}}},
    "Enter the 4-character code." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Saisissez le code de 4 caractères."}}}},
    "Enter the 4-character code, or pick a live joinable fight. Scores stay inside the fight." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Saisissez le code de 4 caractères, ou choisissez un défi ouvert. Les scores restent dans le défi."}}}},
    "Enter the 4-character code, or pick a live public fight. Private fights stay off this list." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Saisissez le code de 4 caractères, ou choisissez un défi public. Les défis privés n’apparaissent pas dans cette liste."}}}},
    "Listed on Join" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Listé dans Rejoindre"}}}},
    "Listed on Join. Anyone with the code or link can join. Usernames are optional." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Listé dans Rejoindre. Toute personne avec le code ou le lien peut rejoindre. Les noms d’utilisateur sont facultatifs."}}}},
    "Not listed" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Non listé"}}}},
    "Not listed. Anyone with the code or link can join. Usernames are optional." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Non listé. Toute personne avec le code ou le lien peut rejoindre. Les noms d’utilisateur sont facultatifs."}}}},
    "Code or link only" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Code ou lien uniquement"}}}},
