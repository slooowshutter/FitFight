        },
        "Daily status": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Statut du jour"
                    }
                }
            }
        },
        "A daily update on a live fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Une mise à jour quotidienne sur un défi en cours."
                    }
                }
            }
        },
        "iPhone has notifications off for FitFight. Open Settings to allow alerts.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L’iPhone a désactivé les notifications pour FitFight. Ouvre Réglages pour autoriser les alertes."
                    }
                }
            }
        },
        "Sign in to change notification settings.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecte-toi pour modifier les notifications."
                    }
                }
            }
        },
        "You can get alerts when someone posts, comments, replies, or reacts in a fight. Turn each one on or off under You → Settings → Notifications.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tu peux recevoir une alerte quand quelqu’un publie, commente, répond ou réagit dans un défi. Active ou coupe chacune sous Vous → Réglages → Notifications."
                    }
                }
            }
        },
        "Media": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Médias"
                    }
                }
            }
        },
        "Add media": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ajouter un média"
                    }
                }
            }
        },
        "Take Photo": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Prendre une photo"
                    }
                }
            }
        },
