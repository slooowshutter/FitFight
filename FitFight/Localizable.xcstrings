                        "state": "translated",
                        "value": "2 participants · 2 sans réponse"
                    }
                }
            }
        },
        "2 weeks": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "2 semaines"
                    }
                }
            }
        },
        "2.2k steps": {
