        "Every day so far": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Chaque jour jusqu’ici"
                    }
                }
            }
        },
        "Every day so far has ten chart styles. Tap a badge to switch between line, histogram, bars, pace, heat, track, oval, rings, stack, and dots.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Chaque jour jusqu’ici propose dix styles de graphique. Touche un badge pour passer de la courbe à l’histogramme, aux barres, au cumul, à la grille, à la course, à l’ovale, aux anneaux, à la pile ou aux points."
                    }
