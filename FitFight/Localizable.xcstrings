                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "3,2 k pas"
                    }
                }
            }
        },
        "3.2k steps behind @sam_sweats": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "3,2 k pas derrière @sam_sweats"
                    }
                }
            }
        },
        "12.0k behind @leo_runs": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "12,0 k derrière @leo_runs"
                    }
                }
            }
        },
        "@ivy_climbs challenged you": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "@ivy_climbs vous a défié"
                    }
                }
            }
        },
        "@ivy_climbs · 7 days": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "@ivy_climbs · 7 jours"
                    }
                }
            }
        },
        "@theo_rows challenged you": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "@theo_rows vous a défié"
                    }
                }
            }
        },
        "@theo_rows · 3 days": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "@theo_rows · 3 jours"
                    }
                }
            }
        },
        "@username": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "@nom_utilisateur"
                    }
                }
            }
        },
        "Accept": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Accepter"
                    }
                }
            }
        },
        "Accept challenge": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Accepter le défi"
                    }
                }
            }
        },
        "Account deleted. To disconnect Apple too, open iPhone Settings, tap your name, then Sign in with Apple → FitFight → Stop Using Apple ID.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Compte supprimé. Pour déconnecter également Apple, ouvrez Réglages sur l’iPhone, touchez votre nom, puis Connexion avec Apple → FitFight → Ne plus utiliser l’identifiant Apple."
                    }
                }
            }
        },
        "Action": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Gage"
                    }
                }
            }
        },
        "Add someone else’s username.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ajoutez le nom d’utilisateur d’une autre personne."
                    }
                }
            }
        },
        "Added to this fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Ajouté à ce défi"
                    }
                }
            }
        },
        "Allow": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Autoriser"
                    }
                }
            }
        },
        "Apple Health": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Santé d’Apple"
                    }
                }
            }
        },
        "Apple Health Steps": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Pas de Santé d’Apple"
                    }
                }
            }
        },
        "Joining or starting a fight now counts Apple Health Steps from the fight start, not from join time, and uploads them right away.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Rejoindre ou lancer un défi compte maintenant les pas Santé d’Apple depuis le début du défi, pas depuis le moment où vous le rejoignez, et les envoie tout de suite."
                    }
                }
            }
        },
        "You can update Apple Health access under You, so existing accounts can allow extra Health types without deleting the account. Fights still use steps only.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Vous pouvez mettre à jour l’accès à Santé dans Vous, pour que les comptes existants autorisent les types Santé supplémentaires sans supprimer le compte. Les défis utilisent encore seulement les pas."
                    }
                }
            }
        },
        "Fight detail corners now follow one scaled family: the header, standings, and chart share the outer card radius, with tighter nested corners on inner rows and chart-type chips.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Les coins du détail d’un défi suivent maintenant une même famille : l’en-tête, le classement et le graphique partagent le rayon des cartes, avec des coins plus serrés sur les lignes imbriquées et les pastilles de type de graphique."
                    }
                }
            }
        },
        "The required-update screen now fills Night and Day correctly, without leftover bands or a muddy overlay.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "L’écran de mise à jour obligatoire s’affiche maintenant correctement en Nuit et en Jour, sans bandes ni voile gris."
                    }
                }
            }
        },
        "Apple sign-in didn’t finish. Try again.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "La connexion avec Apple n’a pas abouti. Réessayez."
                    }
                }
            }
        },
        "Back": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Retour"
                    }
                }
            }
        },
        "Can’t reach the staging database.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Impossible de joindre la base de données de staging."
                    }
                }
            }
        },
        "Cancel": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Annuler"
                    }
                }
            }
        },
        "Challenge your friends. Winner takes the glory.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Défiez vos amis. La gloire revient au vainqueur."
                    }
                }
            }
        },
        "Change": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Modifier"
                    }
                }
            }
        },
        "Close": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Fermer"
                    }
                }
            }
        },
        "View photo": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Voir la photo"
                    }
                }
            }
        },
        "Tap a photo in Feed to see it full screen.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Touche une photo dans le Fil pour la voir en plein écran."
                    }
                }
            }
        },
        "Every day so far opens on the oval. Bars show a small companion next to each name. Heat, stack, and rings are gone.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Jusqu’ici chaque jour s’ouvre sur l’ovale. Les barres montrent un petit compagnon à côté de chaque nom. La grille, la pile et les anneaux ont disparu."
                    }
                }
            }
        },
        "Tapping an animal saves that companion for everyone. If you have not chosen one yet, FitFight will ask you to pick.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Toucher un animal enregistre ce compagnon pour tout le monde. Si tu n’en as pas encore choisi, FitFight te demandera d’en choisir un."
                    }
                }
            }
        },
        "Connect": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecter"
                    }
                }
            }
        },
        "Connect Apple Health above to start this fight.": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connectez Santé d’Apple ci-dessus pour lancer ce défi."
                    }
                }
            }
        },
        "Connect to score this fight": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connectez-vous pour comptabiliser ce défi"
                    }
                }
            }
        },
        "Connected": {
            "localizations": {
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Connecté"
                    }
                }
