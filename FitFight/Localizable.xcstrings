                        "state": "translated",
                        "value": "Your steps · %@"
                    }
                },
                "fr": {
                    "stringUnit": {
                        "state": "translated",
                        "value": "Tes pas · %@"
                    }
                }
            }
        },
        "companion.greet": {
            "extractionState": "manual",
