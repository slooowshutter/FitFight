    "Up to date" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"À jour"}}}},
    "Up to date · Background sync unavailable" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"À jour · synchronisation en arrière-plan indisponible"}}}},
