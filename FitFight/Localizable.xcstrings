    "1 comment" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"1 commentaire"}}}},
    "%lld comments" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"%lld commentaires"}}}},
    "\\(post.commentCount) comments" : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"\\(post.commentCount) commentaires"}}}},
