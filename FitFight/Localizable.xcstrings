    "Couldn’t decline." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Impossible de refuser."}}}},
    "Couldn’t delete account. Try again." : {"localizations":{"fr":{"stringUnit":{"state":"translated","value":"Impossible de supprimer le compte. Réessayez."}}}},
