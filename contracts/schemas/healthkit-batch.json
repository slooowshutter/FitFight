{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitfight.app/schemas/healthkit-batch.json",
  "title": "HealthKitStepsArchiveBatch",
  "description": "A bounded, idempotent archive batch. The backend derives the user from the bearer token.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "samples": {
      "type": "array",
      "maxItems": 250,
      "items": { "$ref": "#/$defs/sample" },
      "default": []
    },
    "deletions": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/deletion" },
      "default": []
    },
    "merged_days": {
      "type": "array",
      "maxItems": 45,
      "items": { "$ref": "#/$defs/mergedDay" },
      "default": []
    },
    "source_days": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/sourceDay" },
      "default": []
    },
    "sync": { "$ref": "#/$defs/sync" }
  },
  "anyOf": [
    {
      "required": ["samples"],
      "properties": { "samples": { "minItems": 1 } }
    },
    {
      "required": ["deletions"],
      "properties": { "deletions": { "minItems": 1 } }
    },
    {
      "required": ["merged_days"],
      "properties": { "merged_days": { "minItems": 1 } }
    },
    {
      "required": ["source_days"],
      "properties": { "source_days": { "minItems": 1 } }
    },
    { "required": ["sync"] }
  ],
  "$defs": {
    "dateTime": { "type": "string", "format": "date-time" },
    "civilDay": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "metadataValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string" },
        "value": { "type": "string" },
        "objc_type": { "type": ["string", "null"] }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "value",
        "unit",
        "starts_at",
        "ends_at",
        "local_day",
        "time_zone",
        "source_name",
        "source_bundle_identifier",
        "metadata"
      ],
      "properties": {
        "sample_id": { "type": "string", "format": "uuid" },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "count" },
        "starts_at": { "$ref": "#/$defs/dateTime" },
        "ends_at": { "$ref": "#/$defs/dateTime" },
        "local_day": { "$ref": "#/$defs/civilDay" },
        "time_zone": { "type": "string" },
        "source_name": { "type": "string" },
        "source_bundle_identifier": { "type": "string" },
        "source_version": { "type": ["string", "null"] },
        "source_product_type": { "type": ["string", "null"] },
        "source_os_version": { "type": ["string", "null"] },
        "device_name": { "type": ["string", "null"] },
        "device_manufacturer": { "type": ["string", "null"] },
        "device_model": { "type": ["string", "null"] },
        "device_hardware_version": { "type": ["string", "null"] },
        "device_firmware_version": { "type": ["string", "null"] },
        "device_software_version": { "type": ["string", "null"] },
        "device_local_identifier": { "type": ["string", "null"] },
        "device_udi_identifier": { "type": ["string", "null"] },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metadataValue" }
        },
        "user_entered": { "type": ["boolean", "null"] }
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id"],
      "properties": {
        "sample_id": { "type": "string", "format": "uuid" }
      }
    },
    "mergedDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "starts_at", "ends_at", "time_zone", "steps"],
      "properties": {
        "day": { "$ref": "#/$defs/civilDay" },
        "starts_at": { "$ref": "#/$defs/dateTime" },
        "ends_at": { "$ref": "#/$defs/dateTime" },
        "time_zone": { "type": "string" },
        "steps": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "starts_at",
        "ends_at",
        "time_zone",
        "source_name",
        "source_bundle_identifier",
        "steps"
      ],
      "properties": {
        "day": { "$ref": "#/$defs/civilDay" },
        "starts_at": { "$ref": "#/$defs/dateTime" },
        "ends_at": { "$ref": "#/$defs/dateTime" },
        "time_zone": { "type": "string" },
        "source_name": { "type": "string" },
        "source_bundle_identifier": { "type": "string" },
        "steps": { "type": "number", "minimum": 0 }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_zone", "complete_through"],
      "properties": {
        "time_zone": { "type": "string" },
        "accessible_from": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "complete_through": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
