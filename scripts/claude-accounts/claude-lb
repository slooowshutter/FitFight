#!/usr/bin/env python3
"""Several Claude subscriptions, one setup. Commands are listed in COMMANDS below.

Account a = ~/.claude (default). Account x = ~/.claude-x, which shares settings, skills, plugins,
memory and sessions with ~/.claude through symlinks and keeps its own login.
Conductor runs ~/.local/bin/claude-active, which reads the chosen account from ~/.claude-lb.
Install: copy claude-lb and claude-active from scripts/claude-accounts/ into ~/.local/bin, set
claude_code_executable_path = "<full path to ~/.local/bin/claude-active>" in ~/.conductor/settings.toml,
then add accounts with `claude-lb new b`.
"""
import glob, hashlib, json, os, re, subprocess, sys, time, urllib.request
from datetime import datetime

COMMANDS = """
Commands
  claude-lb            show 5-hour, weekly and Fable usage of every account
  claude-lb <x>        new Conductor chats use account x, e.g. claude-lb b (open chats keep theirs)
  claude-lb auto       switch to whichever account has the most room left
  claude-lb new <x>    add account x (one letter, b-z), then run claude-<x> and /login
  claude               open account a in a terminal
  claude-<x>           open account x in a terminal, e.g. claude-b"""

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.claude-lb"
SHARED = ["settings.json", "settings.local.json", "CLAUDE.md", "agents", "skills", "plugins", "hooks", "memory", "projects", "history.jsonl", "chrome", "ide"]
ACCOUNTS = {"a": f"{HOME}/.claude"} | {d[-1]: d for d in sorted(glob.glob(f"{HOME}/.claude-[b-z]"))}


def usage(name):
    # Claude Code names a non-default login's keychain item after a hash of its config dir.
    service = "Claude Code-credentials" + ("" if name == "a" else "-" + hashlib.sha256(ACCOUNTS[name].encode()).hexdigest()[:8])
    try:
        raw = json.loads(subprocess.check_output(["security", "find-generic-password", "-s", service, "-w"], stderr=subprocess.DEVNULL))
    except subprocess.CalledProcessError:
        return None
    oauth = raw["claudeAiOauth"]
    if oauth["expiresAt"] / 1000 < time.time() + 60:
        # Idle account: refresh like Claude Code does and save it back. Running claude processes re-read the keychain every 30s.
        body = json.dumps({"grant_type": "refresh_token", "refresh_token": oauth["refreshToken"], "client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e"}).encode()
        req = urllib.request.Request("https://platform.claude.com/v1/oauth/token", body, {"Content-Type": "application/json"})
        new = json.load(urllib.request.urlopen(req))
        oauth.update(accessToken=new["access_token"], refreshToken=new.get("refresh_token", oauth["refreshToken"]), expiresAt=int((time.time() + new["expires_in"]) * 1000))
        cmd = f'add-generic-password -U -a "{os.environ["USER"]}" -s "{service}" -X "{json.dumps(raw).encode().hex()}"\n'
        subprocess.run(["security", "-i"], input=cmd.encode(), check=True, capture_output=True)
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={"Authorization": "Bearer " + oauth["accessToken"], "anthropic-beta": "oauth-2025-04-20"})
    return json.load(urllib.request.urlopen(req))["limits"]


arg = sys.argv[1] if len(sys.argv) > 1 else ""

if arg == "new":
    name = sys.argv[2] if len(sys.argv) > 2 else ""
    if not re.fullmatch("[b-z]", name) or name in ACCOUNTS:
        sys.exit(f"Pick an unused letter from b to z. In use: {', '.join(ACCOUNTS)}")
    folder = f"{HOME}/.claude-{name}"
    os.mkdir(folder)
    for f in SHARED:
        if os.path.exists(f"{HOME}/.claude/{f}"):
            os.symlink(f"{HOME}/.claude/{f}", f"{folder}/{f}")
    config = json.load(open(f"{HOME}/.claude.json"))
    config.pop("oauthAccount", None)  # the new account logs in fresh; MCP servers and project trust carry over
    with open(f"{folder}/.claude.json", "w", opener=lambda p, fl: os.open(p, fl, 0o600)) as out:
        json.dump(config, out, indent=2)
    launcher = f"{HOME}/.local/bin/claude-{name}"
    with open(launcher, "w") as out:
        out.write(f'#!/bin/sh\n# Claude account {name}: own login, everything else shared with ~/.claude. Made by claude-lb new.\nCLAUDE_CONFIG_DIR="$HOME/.claude-{name}" exec "$HOME/.local/bin/claude" "$@"\n')
    os.chmod(launcher, 0o755)
    sys.exit(f"Added account {name}. Run claude-{name} in a terminal, then /login with that subscription.")

active = open(STATE).read().strip() if os.path.exists(STATE) else "a"
limits = {name: usage(name) for name in ACCOUNTS}

if arg in ACCOUNTS or arg == "auto":
    if arg == "auto":
        # ponytail: picks the account whose fullest limit is lowest; ignores reset times
        arg = min((n for n in limits if limits[n]), key=lambda n: max(l["percent"] for l in limits[n]))
    if not limits[arg]:
        sys.exit(f"Account {arg} is not logged in. Run {'claude' if arg == 'a' else 'claude-' + arg} in a terminal and /login first.")
    open(STATE, "w").write(arg)
    print(f"Switched to {arg}. New Conductor chats use it; open chats keep their account.")
    active = arg
elif arg:
    sys.exit(COMMANDS)

for name, rows in limits.items():
    config = f"{HOME}/.claude.json" if name == "a" else f"{ACCOUNTS[name]}/.claude.json"
    email = json.load(open(config)).get("oauthAccount", {}).get("emailAddress", "") if os.path.exists(config) else ""
    print(f"\n{name}  {email}{'  <- active' if name == active else ''}")
    if not rows:
        print("  not logged in")
        continue
    for l in rows:
        label = {"session": "5-hour", "weekly_all": "weekly"}.get(l["kind"]) or "weekly " + ((l["scope"] or {}).get("model") or {}).get("display_name", l["kind"])
        resets = datetime.fromisoformat(l["resets_at"]).astimezone().strftime("%a %H:%M")
        filled = round(l["percent"] * 40 / 100)
        print(f"  {label:<14} {'█' * filled}{'░' * (40 - filled)} {l['percent']:>3}%   resets {resets}")

print(COMMANDS)
