# Supabase project URL (publishable). Preview/develop = develop branch project. Production = main project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only secret key. Never commit a real value. Never put this in iOS.
SUPABASE_SECRET_KEY=

# Optional alias used by some older dashboards. Same value as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Supavisor transaction-pooler URL (port 6543). Never put this in iOS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Optional public site origin for CORS. Native iOS requests have no Origin and still work.
FITFIGHT_APP_URL=https://fitfight.app

# Server-only Sign in with Apple credentials used to exchange and revoke native tokens.
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_SIGN_IN_CLIENT_ID=com.fitfight.mvp

# Base64-encoded 32-byte key used only to encrypt Apple refresh tokens in private storage.
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY=
