# Supabase project URL (publishable). Preview/develop = develop branch project. Production = main project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only secret key. Never commit a real value. Never put this in iOS.
SUPABASE_SECRET_KEY=

# Optional alias used by some older dashboards. Same value as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Supavisor transaction-pooler URL (port 6543). Never put this in iOS.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Optional public site origin for CORS. Native iOS requests have no Origin and still work.
FITFIGHT_APP_URL=https://fitfight.app

# Server-only Sign in with Apple credentials used to exchange and revoke native tokens.
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_SIGN_IN_CLIENT_ID=com.fitfight.mvp

# Base64-encoded 32-byte key used only to encrypt Apple refresh tokens in private storage.
APPLE_SIGN_IN_TOKEN_ENCRYPTION_KEY=

# Server-only OpenRouter key for daily AI challenge-status notifications.
# If unset, the daily job no-ops and does not enqueue notifications.
OPENROUTER_API_KEY=

# Server-only Blend workflow key. Workflow bindings and quotas must be configured before enabling AI.
BLEND_API_KEY=
BLEND_ENABLED=false
BLEND_AVATAR_WORKFLOW_ID=c405d12d-fa25-4e67-8d4d-8336e741cbbc
BLEND_AVATAR_VERSION_ID=ff4f26b1-48f3-4352-bd7d-913e3a481aa4
BLEND_FITNESS_WORKFLOW_ID=fa770c5b-25ba-46cc-a758-a08aeebc1c92
BLEND_FITNESS_VERSION_ID=cf9177c3-9ba5-4a53-87df-e8e304490f43
BLEND_FITNESS_CREDIT_PRICE=
BLEND_GROUP_PHOTO_WORKFLOW_ID=f740d71e-06fe-41d4-a92d-a85c90abd3f9
BLEND_GROUP_PHOTO_VERSION_ID=2d6e0596-14c5-4ba2-948f-642bae407815
BLEND_GROUP_PHOTO_CREDIT_PRICE=
# Required admission caps, set after measuring the pinned workflow and the Blend key allowance.
BLEND_GLOBAL_DAILY_STARTS=
BLEND_GLOBAL_CONCURRENT_RUNS=
BLEND_REQUESTS_PER_MINUTE=

# Server-only APNs credentials for fight-end sync reminders. Never put the .p8 in git or iOS.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.fitfight.mvp
APNS_TOKEN_ENCRYPTION_KEY=

# Server-only Notion internal integration token. Share Product Backlog with it.
# If unset, Bugs & requests still save in the app and skip the backlog row.
NOTION_TOKEN=

# Server-only Cursor Cloud Agents API key (Dashboard → API Keys). Used to
# start a cloud agent from an admin Bugs & requests post. Never put this in iOS.
CURSOR_API_KEY=

# Optional extra admin emails or usernames, comma-separated.
# Defaults already include marc@marclamy.com and username marc.
FITFIGHT_ADMIN_EMAILS=
FITFIGHT_ADMIN_HANDLES=

# Immutable Supabase Auth user ID for suggestions and Fight administration.
# Missing means these admin operations are disabled. Never use an email or handle here.
FITFIGHT_ADMIN_USER_ID=

# Enable only after the matching English/French Privacy disclosure is published.
# Pair artwork generation remains unavailable regardless of this setting.
FITFIGHT_PROFILE_MEASUREMENT_ENABLED=false

# Server-only StoreKit credentials. Keep every private key out of iOS and git.
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_ENVIRONMENT=Sandbox
APPLE_SPECIALS_ENABLED=false
APPLE_CUSTOM_CHARACTERS_ENABLED=false
# Production only: comma-separated FitFight user IDs App Review signs in with. They buy on the Sandbox shelf.
APPLE_IAP_REVIEW_USER_IDS=

# AI grants and evidence-based recovery use FITFIGHT_ADMIN_USER_ID above.
# No automatic credit grants. Keep the minute-level /api/internal/ai/reconcile
# cron authenticated with CRON_SECRET, including while BLEND_ENABLED=false.
