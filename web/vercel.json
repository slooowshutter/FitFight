{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "regions": ["iad1"],
    "crons": [
        {
            "path": "/api/internal/close-fights",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/internal/daily-status-notifications",
            "schedule": "0 9 * * *"
        }
    ],
    "git": {
        "deploymentEnabled": {
            "profiles-friends-and-stats": false
        }
    }
}
